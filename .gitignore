__pycache__/
*.pyc
.DS_Store
.claude/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# LaTeX build artifacts. Figures under latex/figures/ are inputs and stay tracked.
latex/**/*.aux
latex/**/*.log
latex/**/*.out
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.synctex.gz
latex/**/*.bbl
latex/**/*.blg
latex/**/*.toc
latex/*.pdf
# Scratch directory and output PDFs from preview.sh. The .aux/.log inside it are
# already covered above; the PDF is not, since latex/*.pdf matches only direct
# children of latex/.
latex/.preview_build/

# IST-3 text DGP artifacts: downloaded checkpoints and generated intermediates,
# regenerated by dgp/embed_notes.py and dgp/generate_notes.py. The 416 MB
# Bio_ClinicalBERT checkpoint exceeds GitHub's per-file limit. Small artifacts
# such as artifacts_text/config.json remain tracked.
src/air_cate/dgp/artifacts_text/Bio_ClinicalBERT/
src/air_cate/dgp/artifacts_text/embeddings.npz
src/air_cate/dgp/artifacts_text/clinical_notes.json.gz
src/air_cate/dgp/artifacts_text/super_population.npz

# Semi-synthetic IST-3 generator: a 20 MB pre-trained TVAE plus data derived from
# the IST-3 shared dataset, held out of version control pending its data-sharing
# terms. Uncomment the negations to version the small text sources.
IST_VAE/*
# !IST_VAE/README.md
# !IST_VAE/sampler_simplified.py
# !IST_VAE/Data-preparation-IST3.R
# !IST_VAE/piplist.txt

# Per-run output directories from the simulation and plotting scripts, named by
# whatever the run was (smoke/, pilot/, full999_raw/, night_cur_k8/, ...). These
# are scratch, not inputs: 256 MB at last count, with full999_raw/ alone at
# 233 MB. The curated figures that the paper actually includes sit at the top of
# examples/figures/ and stay tracked; only subdirectories are ignored.
examples/figures/*/
# Plot caches keyed by a config fingerprint, regenerated by plot_cate_curves.py.
examples/figures/*.npz
